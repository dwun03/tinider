rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roomPath(roomCode) {
      return /databases/$(database)/documents/groupRooms/$(roomCode);
    }

    function isRoomMember(roomCode) {
      return signedIn()
        && exists(roomPath(roomCode))
        && get(roomPath(roomCode)).data.memberUids.hasAny([request.auth.uid]);
    }

    match /groupRooms/{roomCode} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'roomCode',
          'hostUid',
          'memberUids',
          'gate',
          'budget',
          'status',
          'createdAt'
        ])
        && request.resource.data.roomCode == roomCode
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.status == 'open'
        && request.resource.data.gate is string
        && request.resource.data.budget is string;

      allow get: if signedIn();
      allow list: if false;
      allow delete: if false;

      allow update: if signedIn() && (
        (
          resource.data.status == 'open'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberUids', 'status'])
          && request.resource.data.status == 'swiping'
          && resource.data.memberUids.size() == 1
          && !resource.data.memberUids.hasAny([request.auth.uid])
          && request.resource.data.memberUids.size() == 2
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.hasAny([request.auth.uid])
        )
        || (isRoomMember(roomCode)
          && resource.data.status != 'completed'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'resultSpotId', 'results', 'completedAt'])
          && request.resource.data.status == 'completed'
          && request.resource.data.resultSpotId is string
          && request.resource.data.results is list
          && request.resource.data.results.size() > 0
          && resource.data.memberUids.size() == 2
          && get(/databases/$(database)/documents/groupRooms/$(roomCode)/members/$(resource.data.memberUids[0])).data.completed == true
          && get(/databases/$(database)/documents/groupRooms/$(roomCode)/members/$(resource.data.memberUids[1])).data.completed == true
        )
      );

      match /members/{memberUid} {
        allow get: if signedIn()
          && (request.auth.uid == memberUid || isRoomMember(roomCode));
        allow list: if isRoomMember(roomCode);

        allow create: if signedIn()
          && request.auth.uid == memberUid
          && getAfter(roomPath(roomCode)).data.memberUids.hasAny([memberUid])
          && request.resource.data.keys().hasOnly([
            'memberUid',
            'progress',
            'completed',
            'joinedAt'
          ])
          && request.resource.data.memberUid == memberUid
          && request.resource.data.progress == 0
          && request.resource.data.completed == false;

        allow update: if isRoomMember(roomCode)
          && request.auth.uid == memberUid
          && !resource.data.completed
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['progress', 'completed', 'completedAt', 'updatedAt'])
          && request.resource.data.progress == resource.data.progress + 1
          && request.resource.data.completed is bool
          && (!resource.data.completed || request.resource.data.completed);

        allow delete: if false;
      }

      match /votes/{voteId} {
        allow read: if isRoomMember(roomCode);

        allow create, update: if isRoomMember(roomCode)
          && request.auth.uid == request.resource.data.memberUid
          && request.resource.data.spotId is string
          && voteId == request.auth.uid + '_' + request.resource.data.spotId
          && request.resource.data.direction in ['left', 'right', 'superLike']
          && get(/databases/$(database)/documents/groupRooms/$(roomCode)/members/$(request.auth.uid)).data.completed == false;

        allow delete: if false;
      }
    }
  }
}
