rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roomPath(roomCode) {
      return /databases/$(database)/documents/groupRooms/$(roomCode);
    }

    function memberPath(roomCode, memberUid) {
      return /databases/$(database)/documents/groupRooms/$(roomCode)/members/$(memberUid);
    }

    function isRoomMember(roomCode) {
      return signedIn()
        && exists(roomPath(roomCode))
        && get(roomPath(roomCode)).data.memberUids.hasAny([request.auth.uid]);
    }

    function validExpectedPlayers(expectedPlayers) {
      return expectedPlayers is int
        && expectedPlayers >= 2
        && expectedPlayers <= 8;
    }

    match /users/{userId}/savedSpots/{spotId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'spotId',
          'name',
          'gate',
          'streetAddress',
          'walkingTimeMinutes',
          'averageMealPhp',
          'operatingHours',
          'note',
          'visited',
          'updatedAt'
        ])
        && request.resource.data.spotId == spotId
        && request.resource.data.name is string
        && request.resource.data.gate is string
        && request.resource.data.streetAddress is string
        && request.resource.data.walkingTimeMinutes is int
        && request.resource.data.averageMealPhp is int
        && request.resource.data.operatingHours is string
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 120
        && request.resource.data.visited is bool;
    }

    match /groupRooms/{roomCode} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'roomCode',
          'hostUid',
          'memberUids',
          'gate',
          'budget',
          'expectedPlayers',
          'completedMemberUids',
          'status',
          'createdAt'
        ])
        && request.resource.data.roomCode == roomCode
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && validExpectedPlayers(request.resource.data.expectedPlayers)
        && request.resource.data.completedMemberUids == []
        && request.resource.data.status == 'open'
        && request.resource.data.gate is string
        && request.resource.data.budget is string;

      allow get: if signedIn();
      allow list: if false;
      allow delete: if false;

      allow update: if signedIn() && (
        (
          resource.data.status == 'open'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberUids', 'status'])
          && validExpectedPlayers(resource.data.expectedPlayers)
          && request.resource.data.expectedPlayers == resource.data.expectedPlayers
          && request.resource.data.completedMemberUids == resource.data.completedMemberUids
          && request.resource.data.memberUids.size()
            == resource.data.memberUids.size() + 1
          && resource.data.memberUids.size() < resource.data.expectedPlayers
          && request.resource.data.memberUids.size() <= resource.data.expectedPlayers
          && !resource.data.memberUids.hasAny([request.auth.uid])
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.hasAny([request.auth.uid])
          && (
            (
              request.resource.data.memberUids.size() == resource.data.expectedPlayers
              && request.resource.data.status == 'swiping'
            )
            || (
              request.resource.data.memberUids.size() < resource.data.expectedPlayers
              && request.resource.data.status == 'open'
            )
          )
        )
        || (
          isRoomMember(roomCode)
          && resource.data.status == 'swiping'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['completedMemberUids'])
          && request.resource.data.completedMemberUids.size()
            == resource.data.completedMemberUids.size() + 1
          && request.resource.data.completedMemberUids.hasAll(
            resource.data.completedMemberUids
          )
          && !resource.data.completedMemberUids.hasAny([request.auth.uid])
          && request.resource.data.completedMemberUids.hasAny([request.auth.uid])
          && request.resource.data.memberUids.hasAll(
            request.resource.data.completedMemberUids
          )
          && getAfter(memberPath(roomCode, request.auth.uid)).data.completed == true
        )
        || (
          isRoomMember(roomCode)
          && resource.data.status == 'swiping'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'resultSpotId', 'results', 'completedAt'])
          && request.resource.data.status == 'completed'
          && request.resource.data.resultSpotId is string
          && request.resource.data.results is list
          && request.resource.data.results.size() > 0
          && validExpectedPlayers(resource.data.expectedPlayers)
          && resource.data.memberUids.size() == resource.data.expectedPlayers
          && resource.data.completedMemberUids.size()
            == resource.data.expectedPlayers
          && resource.data.completedMemberUids.hasAll(resource.data.memberUids)
        )
      );

      match /members/{memberUid} {
        allow get: if signedIn()
          && (request.auth.uid == memberUid || isRoomMember(roomCode));
        allow list: if isRoomMember(roomCode);

        allow create: if signedIn()
          && request.auth.uid == memberUid
          && getAfter(roomPath(roomCode)).data.memberUids.hasAny([memberUid])
          && request.resource.data.keys().hasOnly([
            'memberUid',
            'progress',
            'completed',
            'joinedAt'
          ])
          && request.resource.data.memberUid == memberUid
          && request.resource.data.progress == 0
          && request.resource.data.completed == false;

        allow update: if isRoomMember(roomCode)
          && request.auth.uid == memberUid
          && get(roomPath(roomCode)).data.status == 'swiping'
          && !resource.data.completed
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['progress', 'completed', 'completedAt', 'updatedAt'])
          && request.resource.data.progress == resource.data.progress + 1
          && request.resource.data.completed is bool
          && (!resource.data.completed || request.resource.data.completed)
          && (!request.resource.data.completed
            || getAfter(roomPath(roomCode)).data.completedMemberUids
              .hasAny([memberUid]));

        allow delete: if false;
      }

      match /votes/{voteId} {
        allow read: if isRoomMember(roomCode);

        allow create, update: if isRoomMember(roomCode)
          && get(roomPath(roomCode)).data.status == 'swiping'
          && request.auth.uid == request.resource.data.memberUid
          && request.resource.data.spotId is string
          && voteId == request.auth.uid + '_' + request.resource.data.spotId
          && request.resource.data.direction in ['left', 'right', 'superLike']
          && get(/databases/$(database)/documents/groupRooms/$(roomCode)/members/$(request.auth.uid)).data.completed == false;

        allow delete: if false;
      }
    }
  }
}
